{
  "name": "orivexy-nights",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma social para descubrir fiestas, discotecas y eventos nocturnos.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed/index.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "arctic": "^3.7.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.6",
    "nodemailer": "^7.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "supercluster": "^8.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@playwright/test": "~1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "^7.1.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  }
}
