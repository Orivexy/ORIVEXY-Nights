// NIGHTLY — data model.
//
// Conventions:
// - Ids are cuid strings.
// - Money is stored in minor units (cents) with the currency on the country.
// - All timestamps are UTC; local display uses City.timezone.
// - Counters (likeCount, ratingAvg…) are denormalised for fast reads and are
//   updated transactionally by the service layer.
// - `searchText` columns hold lower-cased, accent-free text maintained by the
//   service layer so search works for "gracia" → "Gràcia".

generator client {
  provider      = "prisma-client-js"
  /// "windows" is used by the desktop build (desktop/).
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Geography ───────────────────────────────────────────────────────────────

model Country {
  id       String @id @default(cuid())
  code     String @unique // ISO 3166-1 alpha-2
  name     String
  currency String @default("EUR") // ISO 4217
  cities   City[]
}

model City {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  countryId      String
  country        Country  @relation(fields: [countryId], references: [id])
  timezone       String   @default("Europe/Madrid")
  lat            Float
  lng            Float
  /// Radius (km) around the centre considered "in the city" (discovery, near-me defaults).
  searchRadiusKm Float    @default(25)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  venues           Venue[]
  events           Event[]
  posts            Post[]
  profiles         Profile[]
  discoverySources DiscoverySource[]
}

// ─── Identity ────────────────────────────────────────────────────────────────

/// USER: regular account. ORGANIZER / VENUE: commercial accounts (no staff
/// powers). MODERATOR / ADMIN: staff. Use the helpers in src/lib/roles.ts.
enum Role {
  USER
  ORGANIZER
  VENUE
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  suspendedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  /// Kinds of notification the user turned off in settings.
  mutedNotifications NotificationType[] @default([])

  profile  Profile?
  accounts Account[]
  sessions Session[]

  events         Event[]           @relation("EventOrganizer")
  posts          Post[]
  comments       Comment[]
  likes          Like[]
  reviews        Review[]
  photos         Photo[]
  videos         Video[]
  savedEvents    SavedEvent[]
  savedPosts     SavedPost[]
  attendances    EventAttendance[]
  venueFollows   VenueFollow[]
  artistFollows  ArtistFollow[]
  managedVenues  Venue[]           @relation("VenueManagers")
  followers      Follow[]          @relation("Following")
  following      Follow[]          @relation("Follower")
  notifications  Notification[]    @relation("NotificationRecipient")
  actedNotifs    Notification[]    @relation("NotificationActor")
  reportsFiled   Report[]          @relation("ReportReporter")
  reportsAgainst Report[]          @relation("ReportTargetUser")
  reportsHandled Report[]          @relation("ReportResolver")
  postTags       PostTag[]

  businesses          BusinessProfile[]
  orders              Order[]
  tickets             Ticket[]
  refundsRequested    Refund[]
  auditLogs           AuditLog[]
  reviewedImports     SourceEventRecord[]
  passwordResetTokens PasswordResetToken[]
  blocking            Block[]              @relation("Blocker")
  blockedBy           Block[]              @relation("Blocked")
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username       String   @unique
  displayName    String
  bio            String?
  avatarKey      String?
  /// Music genre slugs the user likes (feeds recommendations).
  favoriteGenres String[] @default([])
  cityId         String?
  city           City?    @relation(fields: [cityId], references: [id])
  followerCount  Int      @default(0)
  followingCount Int      @default(0)
  postCount      Int      @default(0)
  searchText     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([followerCount])
}

/// External identity providers (Google today; Apple/TikTok later).
model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Server-side sessions. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
}

// ─── Taxonomy ────────────────────────────────────────────────────────────────

model Category {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  emoji  String?
  order  Int     @default(0)
  events Event[]
}

model MusicGenre {
  id     String       @id @default(cuid())
  slug   String       @unique
  name   String
  order  Int          @default(0)
  events EventGenre[]
  venues VenueGenre[]
}

model EventGenre {
  eventId String
  genreId String
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  genre   MusicGenre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([eventId, genreId])
  @@index([genreId])
}

model VenueGenre {
  venueId String
  genreId String
  venue   Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  genre   MusicGenre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([venueId, genreId])
  @@index([genreId])
}

// ─── Venues ──────────────────────────────────────────────────────────────────

enum VenueType {
  /// Club (electrónica, underground…)
  CLUB
  BAR
  CONCERT_HALL
  OPEN_AIR
  OTHER
  /// Discoteca (comercial, hits, reggaeton…)
  DISCO
  /// Sala de eventos / recinto (arenas, recintos feriales)
  EVENT_SPACE
  /// Espacio para festivales
  FESTIVAL_SPACE
}

/// Verified state of a place (only OPEN places are listed).
enum VenueStatus {
  OPEN
  TEMPORARILY_CLOSED
  PERMANENTLY_CLOSED
}

model Venue {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  type            VenueType        @default(CLUB)
  description     String?
  cityId          String
  city            City             @relation(fields: [cityId], references: [id])
  address         String
  neighborhood    String?
  /// District (e.g. Sant Martí), for the zone filter.
  district        String?
  status          VenueStatus      @default(OPEN)
  /// Music and event styles (free text from the verified list: "Techno", "Conciertos"…).
  musicTags       String[]         @default([])
  /// Other names the place is known by (old names, rooms), for matching events.
  aliases         String[]         @default([])
  lat             Float
  lng             Float
  coverKey        String?
  /// Weekly schedule: { mon: [{ open: "23:59", close: "06:00" }], ... }
  openingHours    Json?
  priceMin        Int? // cents
  priceMax        Int? // cents
  minAge          Int?
  website         String?
  instagram       String?
  phone           String?
  /// Google Place id (the only Places field that may be stored indefinitely).
  googlePlaceId   String?          @unique
  trust           TrustLevel       @default(COMMUNITY)
  importedAt      DateTime?
  lastSyncedAt    DateTime?
  /// Last time a source confirmed the place still exists.
  lastVerifiedAt  DateTime?
  nextSyncAt      DateTime?
  /// Source whose data wins on sync updates (see src/server/places).
  primarySourceId String?
  primarySource   DiscoverySource? @relation("VenuePrimarySource", fields: [primarySourceId], references: [id], onDelete: SetNull)
  sourceUrl       String?
  /// Provider categories as given by the source (e.g. nightclub, music_venue).
  categories      String[]         @default([])
  /// Where the opening hours come from ("osm", "official", "staff"…) and when they last changed.
  hoursSource     String?
  hoursUpdatedAt  DateTime?
  /// Per-field update times: { phone: ISO, website: ISO, … }
  fieldUpdatedAt  Json?
  /// Set when a source reports the place as permanently closed.
  closedAt        DateTime?
  inactiveReason  String?
  promotionType   SponsorType      @default(NONE)
  ratingAvg       Float            @default(0)
  ratingCount     Int              @default(0)
  followerCount   Int              @default(0)
  isFeatured      Boolean          @default(false)
  isActive        Boolean          @default(true)
  searchText      String           @default("")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  genres    VenueGenre[]
  events    Event[]
  reviews   Review[]
  photos    Photo[]
  posts     Post[]
  followers VenueFollow[]
  managers  User[]        @relation("VenueManagers")
  reports   Report[]

  business         BusinessProfile?
  businessRequests BusinessProfile[]   @relation("BusinessRequestedVenue")
  promotions       Promotion[]
  sourceRecords    SourceVenueRecord[]
  discoverySources DiscoverySource[]
  changes          VenueChange[]

  @@index([cityId, ratingAvg])
  @@index([primarySourceId])
  @@index([cityId, followerCount])
  @@index([lat, lng])
}

model VenueFollow {
  userId    String
  venueId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, venueId])
  @@index([venueId])
}

// ─── Events ──────────────────────────────────────────────────────────────────

enum EventStatus {
  /// Saved by its organizer, not sent to review yet (only they can see it).
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  CANCELLED
  /// No longer listed by its source (hidden, kept for history).
  INACTIVE
}

/// Where an item's information comes from / how much we trust it.
/// COMMUNITY: created by a user · IMPORTED: found by the discovery engine ·
/// OFFICIAL: published by the venue/organizer itself · VERIFIED: reviewed by staff.
enum TrustLevel {
  COMMUNITY
  IMPORTED
  OFFICIAL
  VERIFIED
}

enum EventPricing {
  FREE
  PAID
}

/// How tickets are sold. PLATFORM = native ticketing in (Nombre en proceso) (requires TICKETS_ENABLED).
enum TicketProvider {
  NONE
  EXTERNAL
  PLATFORM
}

enum SalesStatus {
  NOT_ON_SALE
  SCHEDULED
  ON_SALE
  PAUSED
  SOLD_OUT
  CLOSED
}

/// Paid placement marker. NONE = organic content. Anything else must be
/// labelled in the UI and never mixed deceptively with organic content.
enum SponsorType {
  NONE
  FEATURED
  SPONSORED
  AD
}

enum EventSource {
  USER
  VENUE
  IMPORT
}

enum AttendanceStatus {
  INTERESTED
  GOING
}

model Event {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  description     String?
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  cityId          String
  city            City             @relation(fields: [cityId], references: [id])
  venueId         String?
  venue           Venue?           @relation(fields: [venueId], references: [id], onDelete: SetNull)
  organizerId     String
  organizer       User             @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  /// Free-text place name when the event is not tied to a venue (e.g. a street party).
  locationName    String
  address         String?
  lat             Float
  lng             Float
  startsAt        DateTime
  /// The source gave the date but no start time (shown as "hora no publicada", never guessed).
  timeUnknown     Boolean          @default(false)
  endsAt          DateTime?
  /// Door opening time, when different from the start time.
  doorsAt         DateTime?
  /// IANA timezone override; defaults to the city's timezone.
  timezone        String?
  priceMin        Int? // cents; 0 = free, null = unknown
  priceMax        Int? // cents
  /// Overrides the country currency when set (ISO 4217).
  currency        String?
  pricing         EventPricing     @default(FREE)
  ticketProvider  TicketProvider   @default(NONE)
  ticketUrl       String?
  officialUrl     String?
  capacity        Int?
  salesStartAt    DateTime?
  salesEndAt      DateTime?
  refundPolicy    String?
  salesStatus     SalesStatus      @default(NOT_ON_SALE)
  minAge          Int?
  coverKey        String?
  status          EventStatus      @default(PUBLISHED)
  source          EventSource      @default(USER)
  trust           TrustLevel       @default(COMMUNITY)
  /// Organizer name as given by an external source (imported events).
  organizerName   String?
  businessId      String?
  business        BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  /// Source whose data wins on sync updates (see src/server/discovery).
  primarySourceId String?
  primarySource   DiscoverySource? @relation("EventPrimarySource", fields: [primarySourceId], references: [id], onDelete: SetNull)
  importedAt      DateTime?
  lastSyncedAt    DateTime?
  /// Last time a source still listed the event.
  lastVerifiedAt  DateTime?
  /// Page of the event at its primary source (never shown as a ticket link).
  sourceUrl       String?
  /// Editorial pick by staff (free). Paid placement lives in `promotionType`.
  isFeatured      Boolean          @default(false)
  promotionType   SponsorType      @default(NONE)
  interestedCount Int              @default(0)
  goingCount      Int              @default(0)
  searchText      String           @default("")
  reminderSentAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  genres        EventGenre[]
  photos        Photo[]
  posts         Post[]
  attendances   EventAttendance[]
  savedBy       SavedEvent[]
  reports       Report[]
  notifications Notification[]
  ticketTypes   TicketType[]
  orders        Order[]
  tickets       Ticket[]
  promotions    Promotion[]
  sourceRecords SourceEventRecord[]
  changes       EventChange[]
  artists       EventArtist[]

  @@index([cityId, status, startsAt])
  @@index([venueId, startsAt])
  @@index([organizerId])
  @@index([lat, lng])
  @@index([primarySourceId])
  @@index([businessId])
}

model EventAttendance {
  userId    String
  eventId   String
  status    AttendanceStatus
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@id([userId, eventId])
  @@index([eventId, status])
}

model SavedEvent {
  userId    String
  eventId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, eventId])
  @@index([eventId])
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

/// One review per user and venue (editable). Sub-scores are optional 1–5.
model Review {
  id        String   @id @default(cuid())
  userId    String
  venueId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  rating    Int
  ambience  Int?
  music     Int?
  staff     Int?
  price     Int?
  space     Int?
  comment   String?
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, venueId])
  @@index([venueId, createdAt])
}

// ─── Media ───────────────────────────────────────────────────────────────────

enum ContentStatus {
  VISIBLE
  HIDDEN // auto-hidden by reports, pending review
  REMOVED
}

/// A stored image. It can belong to a post (carousel), a venue gallery or an
/// event gallery. Unattached photos (all FKs null) are pending uploads.
model Photo {
  id          String        @id @default(cuid())
  uploaderId  String
  uploader    User          @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  key         String        @unique
  width       Int
  height      Int
  blurDataUrl String?
  postId      String?
  post        Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  venueId     String?
  venue       Venue?        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  position    Int           @default(0)
  /// Where an imported photo came from (the venue's official website…).
  sourceUrl   String?
  /// Part of the place the photo shows (pista, dj, vip, barra…), detected by
  /// the image model (scripts/classify-zones.mts); null = unknown.
  zone        String?
  zoneScore   Float?
  likeCount   Int           @default(0)
  status      ContentStatus @default(VISIBLE)
  createdAt   DateTime      @default(now())

  likes   Like[]
  reports Report[]

  @@index([postId, position])
  @@index([venueId, status, createdAt])
  @@index([eventId, status, createdAt])
  @@index([uploaderId, createdAt])
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

model Video {
  id          String      @id @default(cuid())
  uploaderId  String
  uploader    User        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  key         String      @unique
  posterKey   String?
  width       Int?
  height      Int?
  durationSec Float?
  sizeBytes   Int?
  status      VideoStatus @default(PROCESSING)
  postId      String?     @unique
  post        Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  reports Report[]
}

// ─── Social ──────────────────────────────────────────────────────────────────

enum PostType {
  PHOTO
  CAROUSEL
  VIDEO
}

model Post {
  id            String        @id @default(cuid())
  authorId      String
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type          PostType
  caption       String?
  cityId        String?
  city          City?         @relation(fields: [cityId], references: [id])
  eventId       String?
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  venueId       String?
  venue         Venue?        @relation(fields: [venueId], references: [id], onDelete: SetNull)
  locationName  String?
  likeCount     Int           @default(0)
  commentCount  Int           @default(0)
  saveCount     Int           @default(0)
  status        ContentStatus @default(VISIBLE)
  promotionType SponsorType   @default(NONE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  photos        Photo[]
  video         Video?
  comments      Comment[]
  likes         Like[]
  saves         SavedPost[]
  tags          PostTag[]
  reports       Report[]
  notifications Notification[]
  promotions    Promotion[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@index([eventId, createdAt])
  @@index([venueId, createdAt])
  @@index([cityId, status, createdAt])
}

/// Users tagged in a post.
model PostTag {
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  status    ContentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())

  reports       Report[]
  notifications Notification[]

  @@index([postId, createdAt])
  @@index([authorId])
}

/// A like on exactly one target (post or photo).
model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  photoId   String?
  photo     Photo?   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, photoId])
  @@index([postId])
  @@index([photoId])
}

model SavedPost {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

model Follow {
  followerId  String
  followingId String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

/// A user blocks another: neither sees the other's posts or comments, and
/// they can't follow, comment, tag or notify each other.
model Block {
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// ─── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  FOLLOW
  POST_LIKE
  POST_COMMENT
  POST_TAG
  EVENT_REMINDER
  VENUE_NEW_EVENT
  ARTIST_NEW_EVENT
  EVENT_APPROVED
  EVENT_REJECTED
  CONTENT_REMOVED
  BUSINESS_APPROVED
  BUSINESS_REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type      NotificationType
  postId    String?
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  /// Prevents duplicates for idempotent notifications (reminders, likes).
  dedupeKey String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ─── Moderation ──────────────────────────────────────────────────────────────

enum ReportTargetType {
  USER
  EVENT
  VENUE
  POST
  PHOTO
  VIDEO
  COMMENT
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  HARASSMENT
  FAKE_EVENT
  WRONG_INFO
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// A report points to exactly one target through a nullable FK matching
/// `targetType`, so deleting the target cascades the report away.
model Report {
  id           String           @id @default(cuid())
  reporterId   String
  reporter     User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType
  targetKey    String // `${targetType}:${id}` — enforces one report per user and target
  userId       String?
  user         User?            @relation("ReportTargetUser", fields: [userId], references: [id], onDelete: Cascade)
  eventId      String?
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venueId      String?
  venue        Venue?           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  postId       String?
  post         Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  photoId      String?
  photo        Photo?           @relation(fields: [photoId], references: [id], onDelete: Cascade)
  videoId      String?
  video        Video?           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason       ReportReason
  details      String?
  status       ReportStatus     @default(OPEN)
  resolvedById String?
  resolvedBy   User?            @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime         @default(now())

  @@unique([reporterId, targetKey])
  @@index([status, createdAt])
  @@index([targetKey])
}

// ─── Commerce (prepared, DISABLED by feature flags) ──────────────────────────
//
// Nothing in this section charges money today. Every write path is gated by
// the flags in src/server/monetization/flags.ts and there is no real payment
// provider wired in (see PaymentProvider in src/server/monetization/payments.ts).

enum BusinessType {
  ORGANIZER
  VENUE
}

enum BusinessVerification {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CommercialStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
}

enum PlanCode {
  PLAN_FREE
  PLAN_PREMIUM
  PLAN_BUSINESS
}

/// Commercial identity of an organizer or venue account.
model BusinessProfile {
  id               String               @id @default(cuid())
  ownerId          String
  owner            User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type             BusinessType
  tradeName        String
  contactEmail     String?
  contactPhone     String?
  website          String?
  venueId          String?              @unique
  venue            Venue?               @relation(fields: [venueId], references: [id], onDelete: SetNull)
  verification     BusinessVerification @default(UNVERIFIED)
  verifiedAt       DateTime?
  commercialStatus CommercialStatus     @default(INACTIVE)
  plan             PlanCode             @default(PLAN_FREE)
  /// Self-service request: venue the applicant says they manage (linked on approval).
  requestedVenueId String?
  requestedVenue   Venue?               @relation("BusinessRequestedVenue", fields: [requestedVenueId], references: [id], onDelete: SetNull)
  requestMessage   String?
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  billingProfile  BillingProfile?
  subscriptions   Subscription[]
  events          Event[]
  commissionRules CommissionRule[]
  promotions      Promotion[]
  transactions    Transaction[]
  invoices        Invoice[]

  @@index([ownerId])
  @@index([type, verification])
}

/// Legal/billing data for invoices. Never read from the client without an ownership check.
model BillingProfile {
  id           String          @id @default(cuid())
  businessId   String          @unique
  business     BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  legalName    String
  taxId        String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  countryCode  String          @default("ES")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

/// Catalogue of business plans. Prices are placeholders until configured by an admin.
model Plan {
  id          String   @id @default(cuid())
  code        PlanCode @unique
  name        String
  description String?
  /// Feature keys enabled by the plan (see PLAN_FEATURES in src/server/monetization/plans.ts).
  features    String[]
  priceCents  Int?
  currency    String   @default("EUR")
  interval    String   @default("month")
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id                     String             @id @default(cuid())
  businessId             String
  business               BusinessProfile    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id])
  status                 SubscriptionStatus @default(INACTIVE)
  provider               String?
  providerSubscriptionId String?            @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  invoices Invoice[]

  @@index([businessId, status])
}

/// Configurable fee rules (basis points: 100 bps = 1 %). The most specific
/// active rule wins: event business → global. No rule = no sales possible.
model CommissionRule {
  id               String           @id @default(cuid())
  name             String
  businessId       String?
  business         BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platformFeeBps   Int              @default(0)
  platformFeeFixed Int              @default(0) // cents per ticket
  providerFeeBps   Int              @default(0)
  providerFeeFixed Int              @default(0) // cents per order
  taxRateBps       Int              @default(0)
  /// true: ticket prices already include tax (typical B2C in Spain).
  taxIncluded      Boolean          @default(true)
  /// true: the buyer pays the platform fee on top of the ticket price.
  feesPaidByBuyer  Boolean          @default(true)
  currency         String           @default("EUR")
  isActive         Boolean          @default(false)
  validFrom        DateTime?
  validUntil       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([businessId, isActive])
}

enum TicketTypeStatus {
  DRAFT
  ACTIVE
  HIDDEN
  SOLD_OUT
}

model TicketType {
  id           String           @id @default(cuid())
  eventId      String
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  priceCents   Int
  currency     String           @default("EUR")
  capacity     Int?
  soldCount    Int              @default(0)
  maxPerOrder  Int              @default(10)
  salesStartAt DateTime?
  salesEndAt   DateTime?
  status       TicketTypeStatus @default(DRAFT)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  orderItems OrderItem[]
  tickets    Ticket[]

  @@index([eventId, status])
}

enum OrderStatus {
  CREATED
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Amounts are computed server-side from TicketType + CommissionRule and
/// frozen here at creation time. All in cents of `currency`.
model Order {
  id               String      @id @default(cuid())
  number           String      @unique
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  eventId          String
  event            Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  status           OrderStatus @default(CREATED)
  currency         String
  subtotal         Int
  platformFee      Int
  providerFee      Int
  tax              Int
  total            Int
  organizerAmount  Int
  commissionRuleId String?
  idempotencyKey   String?     @unique
  expiresAt        DateTime?
  paidAt           DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items        OrderItem[]
  tickets      Ticket[]
  payments     Payment[]
  refunds      Refund[]
  transactions Transaction[]
  invoices     Invoice[]

  @@index([userId, createdAt])
  @@index([eventId, status])
}

model OrderItem {
  id           String     @id @default(cuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Int
  total        Int
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
}

model Ticket {
  id           String       @id @default(cuid())
  code         String       @unique
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  eventId      String
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ownerId      String
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  status       TicketStatus @default(VALID)
  checkedInAt  DateTime?
  createdAt    DateTime     @default(now())

  @@index([ownerId])
  @@index([eventId, status])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

/// A charge attempt at the payment provider. Status changes ONLY through
/// verified provider callbacks (webhooks), never from the admin UI or client.
model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          String
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  amount            Int
  currency          String
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  refunds      Refund[]
  transactions Transaction[]

  @@index([orderId])
}

enum RefundStatus {
  REQUESTED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Full or partial refund. It becomes SUCCEEDED only when the provider confirms it.
model Refund {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId        String?
  payment          Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount           Int
  currency         String
  reason           String?
  status           RefundStatus @default(REQUESTED)
  providerRefundId String?      @unique
  requestedById    String?
  requestedBy      User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  resolvedAt       DateTime?

  transactions Transaction[]

  @@index([orderId])
}

enum TransactionType {
  CHARGE
  REFUND
  PLATFORM_FEE
  PROVIDER_FEE
  PAYOUT
  ADJUSTMENT
}

/// Append-only money ledger (history of operations per business).
model Transaction {
  id                String           @id @default(cuid())
  type              TransactionType
  amount            Int
  currency          String
  businessId        String?
  business          BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId         String?
  payment           Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refundId          String?
  refund            Refund?          @relation(fields: [refundId], references: [id], onDelete: SetNull)
  providerReference String?
  description       String?
  createdAt         DateTime         @default(now())

  @@index([businessId, createdAt])
  @@index([orderId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

/// Invoice record prepared for an external invoicing provider. No legal
/// invoices are issued while INVOICING_ENABLED is false (numbers stay null).
model Invoice {
  id                String           @id @default(cuid())
  number            String?          @unique
  status            InvoiceStatus    @default(DRAFT)
  businessId        String?
  business          BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscriptionId    String?
  subscription      Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customerName      String
  customerTaxId     String?
  /// Snapshot of billing data at issue time.
  billingDetails    Json?
  subtotal          Int
  tax               Int
  total             Int
  currency          String
  provider          String?
  providerInvoiceId String?          @unique
  createdAt         DateTime         @default(now())
  issuedAt          DateTime?
  paidAt            DateTime?

  lines InvoiceLine[]

  @@index([businessId, createdAt])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitAmount  Int
  taxRateBps  Int     @default(0)
  total       Int
}

enum PromotionType {
  FEATURED_EVENT
  FEATURED_VENUE
  SPONSORED_POST
  AD
}

enum PromotionStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ENDED
  REJECTED
}

/// Paid visibility campaign. Only ACTIVE promotions set `promotionType` on
/// the target, which the UI always labels ("Destacado" / "Patrocinado" / "Publicidad").
model Promotion {
  id          String           @id @default(cuid())
  businessId  String?
  business    BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  type        PromotionType
  status      PromotionStatus  @default(DRAFT)
  placement   String?
  eventId     String?
  event       Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venueId     String?
  venue       Venue?           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  postId      String?
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  startsAt    DateTime?
  endsAt      DateTime?
  budgetCents Int?
  currency    String           @default("EUR")
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, startsAt])
}

/// Staff and commercial operations log (who did what, when, from where).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

// ─── Event discovery ─────────────────────────────────────────────────────────
//
// Sources → connector → normalisation → deduplication → validation → Event.
// See src/server/discovery.

enum DiscoverySourceType {
  ICS_FEED
  JSON_LD_PAGE
  PARTNER_FEED
  TICKETMASTER
  GOOGLE_PLACES
  OSM_OVERPASS
  MADRID_AGENDA
  CATALONIA_AGENDA
  BCN_MUSIC_VENUES
  /// Verified list of places kept in the code (src/server/discovery/curated).
  CURATED
}

enum DiscoverySyncStatus {
  IDLE
  RUNNING
  OK
  ERROR
}

model DiscoverySource {
  id                  String              @id @default(cuid())
  key                 String              @unique
  name                String
  type                DiscoverySourceType
  enabled             Boolean             @default(false)
  url                 String?
  cityId              String
  city                City                @relation(fields: [cityId], references: [id])
  /// Club/promoter the source belongs to (official website or partner feed).
  venueId             String?
  venue               Venue?              @relation(fields: [venueId], references: [id], onDelete: SetNull)
  /// Trust assigned to items from this source (IMPORTED or OFFICIAL).
  trust               TrustLevel          @default(IMPORTED)
  /// Publish automatically when an item passes every quality check.
  autoPublish         Boolean             @default(false)
  /// Allowed to store images from this source (licence/permission confirmed).
  allowImages         Boolean             @default(false)
  /// Hide events that disappear from the source.
  deactivateMissing   Boolean             @default(true)
  /// Minutes between syncs; null = EVENT_SYNC_INTERVAL.
  syncIntervalMin     Int?
  /// Connector options (never secrets: API keys come from env).
  config              Json?
  status              DiscoverySyncStatus @default(IDLE)
  lockedUntil         DateTime?
  lastSyncAt          DateTime?
  nextSyncAt          DateTime?
  lastError           String?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  /// Consecutive failed syncs (exponential backoff).
  consecutiveFailures Int                 @default(0)
  eventsFound         Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  runs          SyncRun[]
  eventRecords  SourceEventRecord[]
  venueRecords  SourceVenueRecord[]
  primaryEvents Event[]             @relation("EventPrimarySource")
  primaryVenues Venue[]             @relation("VenuePrimarySource")
  changes       EventChange[]
  venueChanges  VenueChange[]

  @@index([enabled, nextSyncAt])
}

model SyncRun {
  id          String              @id @default(cuid())
  /// Null for job-level runs (see SyncJob).
  sourceId    String?
  source      DiscoverySource?    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// Job that triggered the run (VENUE_SYNC, EVENT_SYNC, VENUE_HOURS_SYNC).
  job         String?
  status      DiscoverySyncStatus
  startedAt   DateTime            @default(now())
  finishedAt  DateTime?
  found       Int                 @default(0)
  created     Int                 @default(0)
  updated     Int                 @default(0)
  unchanged   Int                 @default(0)
  duplicates  Int                 @default(0)
  queued      Int                 @default(0)
  skipped     Int                 @default(0)
  deactivated Int                 @default(0)
  errors      Int                 @default(0)
  log         String?

  @@index([sourceId, startedAt])
  @@index([job, startedAt])
}

enum ImportReviewStatus {
  /// Linked to a published event automatically.
  AUTO
  PENDING
  APPROVED
  REJECTED
  MERGED
}

/// One item as seen in one source. Several records can point to the same
/// Event (deduplication); records without an event form the review queue.
model SourceEventRecord {
  id            String             @id @default(cuid())
  sourceId      String
  source        DiscoverySource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId    String
  sourceUrl     String?
  eventId       String?
  event         Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// Normalised payload (NormalizedEvent) from the last sync.
  data          Json
  contentHash   String
  reviewStatus  ImportReviewStatus @default(PENDING)
  reviewReasons String[]
  /// Suggested existing event when a possible duplicate was detected.
  duplicateOfId String?
  matchScore    Float?
  reviewedById  String?
  reviewedBy    User?              @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  missedSyncs   Int                @default(0)
  importedAt    DateTime           @default(now())
  lastSeenAt    DateTime           @default(now())
  lastSyncedAt  DateTime           @default(now())

  @@unique([sourceId, externalId])
  @@index([eventId])
  @@index([reviewStatus, importedAt])
}

model SourceVenueRecord {
  id            String             @id @default(cuid())
  sourceId      String
  source        DiscoverySource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId    String
  venueId       String?
  venue         Venue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  data          Json
  contentHash   String
  reviewStatus  ImportReviewStatus @default(PENDING)
  reviewReasons String[]
  duplicateOfId String?
  /// Data from sources with caching limits (e.g. Google Places) is purged after this date.
  expiresAt     DateTime?
  /// Consecutive healthy syncs in which the source no longer listed the place.
  missedSyncs   Int                @default(0)
  importedAt    DateTime           @default(now())
  lastSeenAt    DateTime           @default(now())

  @@unique([sourceId, externalId])
  @@index([reviewStatus, importedAt])
  @@index([venueId])
}

/// Field-level history of changes applied by sync or staff.
model EventChange {
  id        String           @id @default(cuid())
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sourceId  String?
  source    DiscoverySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime         @default(now())

  @@index([eventId, createdAt])
}

/// Field-level history of venue changes applied by sync or staff.
model VenueChange {
  id        String           @id @default(cuid())
  venueId   String
  venue     Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sourceId  String?
  source    DiscoverySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime         @default(now())

  @@index([venueId, createdAt])
  @@index([createdAt])
}

/// Background sync jobs (VENUE_SYNC, EVENT_SYNC, VENUE_HOURS_SYNC): schedule,
/// lease and health. Each run is logged in SyncRun (job = name).
model SyncJob {
  name                String              @id
  enabled             Boolean             @default(true)
  /// Minutes between runs; null = the job's env default.
  intervalMin         Int?
  status              DiscoverySyncStatus @default(IDLE)
  lockedUntil         DateTime?
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastError           String?
  consecutiveFailures Int                 @default(0)
  nextRunAt           DateTime?
  lastResult          Json?
  updatedAt           DateTime            @updatedAt
}

/// Requests made to paid/limited external APIs, per provider and day (quota + cost control).
model ApiUsage {
  provider String
  day      DateTime @db.Date
  requests Int      @default(0)
  errors   Int      @default(0)

  @@id([provider, day])
}

/// One-time password reset link (only the SHA-256 of the token is stored).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Runtime settings editable by admins (/admin/settings). Env vars are the defaults.
model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// A DJ, band or performer. Created from event line-ups (organizers' forms and
/// the performers that official sources publish), never invented.
model Artist {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  /// Accent- and case-insensitive name, to match the same artist across sources.
  nameKey       String         @unique
  bio           String?
  imageKey      String?
  website       String?
  instagram     String?
  followerCount Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  events        EventArtist[]
  followers     ArtistFollow[]
}

model EventArtist {
  eventId  String
  artistId String
  position Int    @default(0)
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([eventId, artistId])
  @@index([artistId])
}

model ArtistFollow {
  userId    String
  artistId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, artistId])
  @@index([artistId])
}

enum InteractionType {
  EVENT_VIEW
  VENUE_VIEW
  ARTIST_VIEW
  SEARCH
  TICKET_CLICK
  SHARE
  SAVE
}

/// Internal product metrics. No IP, user agent or location is stored; the
/// user id only for signed-in users (it feeds their recommendations).
model Interaction {
  id         String          @id @default(cuid())
  type       InteractionType
  userId     String?
  eventId    String?
  venueId    String?
  artistId   String?
  /// Search text (trimmed, max 80 chars) for SEARCH.
  query      String?
  createdAt  DateTime        @default(now())

  @@index([type, createdAt])
  @@index([eventId, type])
  @@index([userId, createdAt])
}
