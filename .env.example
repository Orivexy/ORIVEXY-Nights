# Development defaults. For production use .env.production.example.
# NEVER commit real keys, passwords or secrets: .env* files are git-ignored.

# ─── Core ─────────────────────────────────────────────────────────────
# Public base URL of the app (used for OAuth callbacks and share links).
APP_URL="http://localhost:3000"

# PostgreSQL connection string.
DATABASE_URL="postgresql://nightly:nightly@localhost:5432/nightly?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────
# Google OAuth (optional). Callback URL: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional email (password recovery). Without it, "¿Has olvidado tu
# contraseña?" explains that recovery is not available (in development the
# reset link is printed in the server log instead).
# Example: smtps://USER:PASSWORD@smtp.example.com:465
SMTP_URL=""
EMAIL_FROM=""

# Desktop app only: the first account created becomes ADMIN.
# Never enable it on a public site (create the admin with ADMIN_* below).
FIRST_USER_IS_ADMIN="false"

# ─── Base seed (npm run db:seed) ──────────────────────────────────────
# The seed only creates base data (countries, cities, categories, genres,
# plans, discovery sources). It never creates fake users, venues or events.
# Optional first admin account (password ≥ 10 chars):
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_USERNAME="admin"
# Cities whose discovery sources start enabled: "all" or comma separated slugs.
SEED_DISCOVERY_CITIES="all"

# ─── Moderation ───────────────────────────────────────────────────────
# Defaults; admins can change them at runtime in /admin/settings.
# How user-created events are published: "off" (publish immediately),
# "new_users" (accounts younger than 7 days go to review) or "all".
EVENT_MODERATION="new_users"
# Unique reports needed to auto-hide a piece of content until reviewed.
AUTO_HIDE_REPORT_THRESHOLD="5"

# ─── Storage ──────────────────────────────────────────────────────────
# "local" stores files on disk (one server with a persistent disk).
# "s3" stores them in any S3-compatible bucket (AWS S3, Cloudflare R2,
# MinIO, Backblaze B2). Files never go into PostgreSQL.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
# Non-AWS providers: e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional public CDN / bucket URL: /media redirects there (set it at build time too, for the CSP).
S3_PUBLIC_URL=""
MAX_IMAGE_MB="12"
MAX_VIDEO_MB="80"

# ─── Maps ─────────────────────────────────────────────────────────────
# "openfreemap" (vector, no key), "carto" (raster, no key), "mapbox" or "maptiler". Keys stay server-side:
# keyed providers are served through /api/map/tiles.
MAP_PROVIDER="openfreemap"
# Vector style for MapLibre (free, no key). "carto" = raster tiles with Leaflet.
MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"
MAPBOX_TOKEN=""
MAPTILER_KEY=""

# ─── Jobs ─────────────────────────────────────────────────────────────
# Protects /api/cron/* endpoints (send as "Authorization: Bearer <secret>").
# Generate one with: openssl rand -hex 32
CRON_SECRET=""
# Run periodic jobs (event reminders) inside the Next.js process.
ENABLE_INPROCESS_JOBS="true"

# ─── Rate limiting ────────────────────────────────────────────────────
# Multiplier for per-IP limits (use 10+ locally, where all requests share one IP).
RATE_LIMIT_SCALE="1"

# ─── Monetization (all OFF: (Nombre en proceso) is free) ────────────────────────────
# See docs/monetization.md. Each feature needs the master switch AND its
# flag, plus a real payment/invoicing provider implemented in code.
MONETIZATION_ENABLED="false"
TICKETS_ENABLED="false"
PREMIUM_VENUES_ENABLED="false"
SUBSCRIPTIONS_ENABLED="false"
SPONSORED_CONTENT_ENABLED="false"
ADS_ENABLED="false"
INVOICING_ENABLED="false"

# ─── Event discovery + places sync ────────────────────────────────────
# See docs/event-discovery.md and docs/places-and-map.md. Sources are set up
# in /admin/discovery; job status, API usage and errors in /admin/map-data
# and /admin/event-data. ALL KEYS ARE SERVER-SIDE ONLY: never prefix them
# with NEXT_PUBLIC_ and never commit real values.
DISCOVERY_ENABLED="true"
# Job intervals (e.g. 30m, 2h, 1d). Can be overridden per job in the admin.
EVENT_SYNC_INTERVAL="30m"
VENUE_SYNC_INTERVAL="24h"
VENUE_HOURS_SYNC_INTERVAL="12h"
# Allow fetching from private/loopback hosts (only for local testing).
DISCOVERY_ALLOW_PRIVATE_HOSTS="false"

# OpenStreetMap / Overpass: no key. Public instance fair use ≈ 10 000
# requests and 1 GB per day; (Nombre en proceso) needs a handful per day.
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
OVERPASS_DAILY_LIMIT="200"
# Public mirrors tried in order when the main instance is busy (comma separated).
OVERPASS_MIRRORS="https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter"
# Folder with recorded public source responses, imported once into an empty
# database (the desktop app sets it; see scripts/record-snapshot.mts).
DISCOVERY_SNAPSHOT_DIR=""

# Google Places API (New) — optional. https://console.cloud.google.com →
# enable "Places API (New)" → Credentials → API key restricted to that API
# (and to your server IP). Its terms only let (Nombre en proceso) keep place IDs, so it is
# used to link places and detect closures (see docs/places-and-map.md).
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACES_DAILY_LIMIT="150"
# Optional: your price per 1000 requests, to estimate cost in /admin/map-data.
GOOGLE_PLACES_COST_PER_1000=""

# Ticketmaster Discovery API — optional. https://developer.ticketmaster.com
# (free key: 5000 calls/day, 5 req/s).
TICKETMASTER_API_KEY=""
TICKETMASTER_DAILY_LIMIT="1000"

# ─── Geocoding (Nominatim, no key) ────────────────────────────────────
# Public OpenStreetMap Nominatim by default (1 request/s policy respected).
# NOMINATIM_URL="https://nominatim.openstreetmap.org"
# NOMINATIM_DAILY_LIMIT="1000"

# ─── Satellite layer (optional) ───────────────────────────────────────
# WMTS/XYZ ortophoto tiles; the default is the ICGC (Catalonia) public service.
# MAP_SATELLITE_URL="https://geoserveis.icgc.cat/icc_mapesmultibase/noutm/wmts/orto/GRID3857/{z}/{x}/{y}.jpeg"
# MAP_SATELLITE_ATTRIBUTION="© Institut Cartogràfic i Geològic de Catalunya"

# ─── Venue zones (optional) ───────────────────────────────────────────
# JSON produced by scripts/classify-zones.mts (zone detected in each official photo).
# ZONE_HINTS_FILE=""
