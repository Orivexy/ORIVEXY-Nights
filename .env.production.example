# ORIVEXY NIGHTS — production configuration template.
# Copy to .env.production (git-ignored), fill in real values on the server
# or in your hosting provider's secret manager. NEVER commit real values.

NODE_ENV="production"
# Public https:// URL (cookies are only Secure over HTTPS; OAuth and email links use it).
APP_URL="https://app.example.com"

# docker-compose builds DATABASE_URL from these; set DATABASE_URL directly on other hosts.
POSTGRES_USER="app"
POSTGRES_PASSWORD=""
POSTGRES_DB="app"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/app?schema=public&sslmode=require"

# First admin (created by the seed on the first deploy; password ≥ 10 chars).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_USERNAME="admin"
SEED_DISCOVERY_CITIES="all"
FIRST_USER_IS_ADMIN="false"

# Password recovery email (required for "¿Has olvidado tu contraseña?").
SMTP_URL=""
EMAIL_FROM="ORIVEXY NIGHTS <no-reply@app.example.com>"

# Google login (optional). Redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Media storage. Use s3 with several instances or without a persistent disk.
STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
MAX_IMAGE_MB="12"
MAX_VIDEO_MB="80"

# Maps: carto needs no key; mapbox / maptiler keys stay on the server.
MAP_PROVIDER="carto"
MAPBOX_TOKEN=""
MAPTILER_KEY=""

# Jobs. One instance: in-process. Several instances: set false on all but
# one, or call /api/cron/<job> from an external scheduler (docs/deployment.md).
ENABLE_INPROCESS_JOBS="true"
# openssl rand -hex 32
CRON_SECRET=""

# Moderation defaults (editable at runtime in /admin/settings).
EVENT_MODERATION="new_users"
AUTO_HIDE_REPORT_THRESHOLD="5"
RATE_LIMIT_SCALE="1"

# Discovery / places sync.
DISCOVERY_ENABLED="true"
EVENT_SYNC_INTERVAL="30m"
VENUE_SYNC_INTERVAL="24h"
VENUE_HOURS_SYNC_INTERVAL="12h"
DISCOVERY_ALLOW_PRIVATE_HOSTS="false"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
OVERPASS_DAILY_LIMIT="200"
TICKETMASTER_API_KEY=""
TICKETMASTER_DAILY_LIMIT="1000"
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACES_DAILY_LIMIT="150"
GOOGLE_PLACES_COST_PER_1000=""

# Monetization stays off until a payment provider is implemented (docs/monetization.md).
MONETIZATION_ENABLED="false"
TICKETS_ENABLED="false"
PREMIUM_VENUES_ENABLED="false"
SUBSCRIPTIONS_ENABLED="false"
SPONSORED_CONTENT_ENABLED="false"
ADS_ENABLED="false"
INVOICING_ENABLED="false"
