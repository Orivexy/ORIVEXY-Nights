{
  "name": "orivexy-nights-desktop",
  "productName": "ORIVEXY NIGHTS",
  "version": "0.1.0",
  "description": "ORIVEXY NIGHTS para Windows, Linux y Mac: app completa con servidor y base de datos incluidos.",
  "author": "ORIVEXY NIGHTS",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "build:win": "bash ../scripts/build-desktop.sh"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "embedded-postgres": "^16.14.0-beta.17",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.nivex.desktop",
    "productName": "ORIVEXY NIGHTS",
    "copyright": "ORIVEXY NIGHTS",
    "directories": {
      "output": "../dist-desktop",
      "buildResources": "build"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "main.mjs",
      "backend.mjs",
      "splash.html",
      "keys-preload.cjs",
      "app-preload.cjs",
      "admin-preload.cjs",
      "admin.html",
      "keys.html",
      "package.json",
      "build/icon.png",
      "build/icon.ico",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "files": [
        "!node_modules/@embedded-postgres/linux-*/**",
        "!node_modules/@embedded-postgres/darwin-*/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORIVEXY NIGHTS",
      "artifactName": "ORIVEXY-NIGHTS-Windows.${ext}",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Orivexy/ORIVEXY-Nights/releases/latest/download"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Fiestas, discotecas y eventos cerca de ti",
      "artifactName": "ORIVEXY-NIGHTS-Linux.${ext}",
      "files": [
        "!node_modules/@embedded-postgres/windows-*/**",
        "!node_modules/@embedded-postgres/darwin-*/**"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.lifestyle",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "ORIVEXY-NIGHTS-Mac.${ext}",
      "files": [
        "!node_modules/@embedded-postgres/windows-*/**",
        "!node_modules/@embedded-postgres/linux-*/**"
      ]
    },
    "dmg": {
      "title": "ORIVEXY NIGHTS",
      "artifactName": "ORIVEXY-NIGHTS-Mac.${ext}"
    }
  }
}
